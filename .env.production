# 배포(vite build) 전용 값. .env 보다 우선한다.
# 여기 값은 빌드 결과 JS 에 그대로 박혀 공개되므로 비밀값을 넣지 않는다.

# 정적 호스팅(workers.dev)에는 백엔드가 없다. 목 데이터로만 동작시킨다.
VITE_USE_MOCK=true

# 게이트웨이·OAuth2 는 배포본에서 쓰지 않는다.
VITE_API_BASE_URL=
VITE_AUTH_SERVER_URL=
VITE_CLIENT_ID=
VITE_CLIENT_SECRET=
VITE_REDIRECT_URI=

# ⚠ 브라우저 번들에 그대로 노출되므로 배포본에는 키를 넣지 않는다.
#    키가 없으면 AI 기능은 규칙 기반 폴백으로 동작한다.
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4o-mini
