# 이 파일을 .env 로 복사해서 쓴다.  cp .env.example .env
# 값이 비어 있는 항목만 직접 채우면 된다. 나머지는 로컬 실습 환경 기준으로 채워 두었다.

# ── 백엔드 (게이트웨이) ─────────────────────────────────────────
# 비워두면 Vite 프록시(/api · /oauth2 · /login → http://localhost:8080)를 탄다.
# 다른 호스트의 게이트웨이를 쓸 때만 채운다.
VITE_API_BASE_URL=
VITE_AUTH_SERVER_URL=http://localhost:8080

# ── OAuth2 클라이언트 ──────────────────────────────────────────
# 실습용 auth-server 이미지에 인메모리로 등록된 클라이언트를 쓴다.
# 서비스 간 호출용으로 service-client 도 함께 등록되어 있다.
VITE_CLIENT_ID=web-client

# 실습 auth-server 기본값은 web-secret 이다. 값은 저장소에 두지 않고 .env 에만 채운다.
VITE_CLIENT_SECRET=

# ⚠ redirect_uri 가 auth-server 에 3000 포트로 등록되어 있다.
#    실제 로그인을 붙이려면 프론트를 3000 포트로 띄워야 한다.
VITE_REDIRECT_URI=http://localhost:3000/callback

# ── 시연 모드 ──────────────────────────────────────────────────
# true  : 백엔드 없이 목 데이터로 동작 (기본값 — 바로 실행 가능)
# false : 게이트웨이의 실제 API 를 호출. 로그인과 시드 데이터가 필요하다.
#         npm run seed:demo 로 계정·과정·수강 이력을 넣을 수 있다.
# 전사 인원·부서·직무·이수 이력은 백엔드에 없는 값이라 두 모드 모두
# src/data/population.js 의 명부에서 계산한다.
VITE_USE_MOCK=true

# ── AI (HR 전용 4곳 · OpenAI) ──────────────────────────────────
# 비워두면 규칙 기반 폴백으로 동작하므로 키 없이도 시연은 진행된다.
# ⚠ 브라우저에 노출되는 키 — 시연 한정. Sprint2에서 recommend-service 로 이관.
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4o-mini
